// Production schema for a rebuild of the MPOnline/Smart School college ERP.
// Postgres. Multi-campus ready. LIVE field names mapped in comments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ───────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  campuses  Campus[]
}

model Campus {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  name           String // LIVE sch_name
  code           String? // LIVE sch_dise_code
  address        String? // LIVE sch_address
  phone          String? // LIVE sch_phone
  email          String? // LIVE sch_email
  timezone       String  @default("Asia/Kolkata")
  dateFormat     String  @default("DD/MM/YYYY")
  startWeek      Int     @default(1)
  startMonth     Int     @default(6)
  currencyCode   String  @default("INR")
  currencyFormat String?
  currencyPlace  String  @default("before") // before | after
  baseUrl        String?
  uploadPath     String?
  currentSessionId String?
  slug           String?
  isActive       Boolean  @default(true)
  logoFileName   String?
  createdAt      DateTime @default(now())

  sessions     AcademicSession[]
  departments  Department[]
  users        User[]
  students     Student[]
  staff        Staff[]
  settings     Setting[]
  auditLogs    AuditLog[]
  routes       SchoolRoute[]
  notices      Notice[]
  events       Event[]
  messages     Message[]
  questionnaires Questionnaire[]
  storeItems   StoreItem[]
  storeVendors StoreVendor[]
  staffCategories StaffCategory[]
  externalLinks ExternalLink[]
  subjectCategories SubjectCategory[]
  subjectTypes  SubjectType[]
  admissionEnquiries AdmissionEnquiry[]
}

model AcademicSession {
  id         String   @id @default(cuid())
  campusId   String
  campus     Campus   @relation(fields: [campusId], references: [id])
  name       String // LIVE session "2025-26"
  code       String? // LIVE session_code
  sequenceNo Int      @default(0)
  startDate  DateTime?
  endDate    DateTime?
  isCurrent  Boolean  @default(false)
  isActive   Boolean  @default(true)

  enrollments StudentEnrollment[]
  feeMasters  FeeMaster[]
  examGroups  ExamGroup[]
  invoices    FeeInvoice[]
  optionalSubjects StudentOptionalSubject[]

  @@unique([campusId, name])
  @@index([campusId, isCurrent])
}

model Setting {
  id       String @id @default(cuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])
  key      String
  value    Json
  @@unique([campusId, key])
}

// ─── Auth / RBAC ───────────────────────────────────────────

enum ActorType {
  STAFF
  STUDENT
  GUARDIAN
  APPLICANT
}

model User {
  id           String    @id @default(cuid())
  campusId     String
  campus       Campus    @relation(fields: [campusId], references: [id])
  actorType    ActorType
  email        String?
  username     String
  passwordHash String
  phone        String?
  firstName    String    @default("")
  lastName     String    @default("")
  mustChangePassword Boolean @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  staff          Staff?
  student        Student?
  guardian       Guardian?
  roles          UserRole[]
  audit          AuditLog[]
  passwordResets PasswordReset[]

  @@unique([campusId, username])
  @@index([campusId, email])
}

model Role {
  id       String  @id @default(cuid())
  campusId String?
  name     String
  isSystem Boolean @default(false)
  users    UserRole[]
  grants   RolePermission[]
  @@unique([campusId, name])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model Permission {
  id      String @id @default(cuid())
  module  String // students, fees, exams...
  feature String // collect_fees, mark_entry...
  action  String // view add edit delete export approve collect publish
  grants  RolePermission[]
  @@unique([module, feature, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  campusId  String?
  campus    Campus?  @relation(fields: [campusId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([campusId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

// ─── Academics ─────────────────────────────────────────────

enum ProgramLevel {
  UNDERGRADUATE // LIVE
  POSTGRADUATE
  DIPLOMA
  CERTIFICATE
}

model Department {
  id       String  @id @default(cuid())
  campusId String
  campus   Campus  @relation(fields: [campusId], references: [id])
  name     String // LIVE
  code     String?
  programs Program[]
  staff    Staff[]
  @@unique([campusId, name])
}

model Program {
  id           String       @id @default(cuid())
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  name         String
  code         String?
  level        ProgramLevel @default(UNDERGRADUATE)
  durationYears Int         @default(3)
  classes      Class[]
  specializations Specialization[]
}

model Specialization {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])
  name      String
}

model Class {
  id             String   @id @default(cuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id])
  name           String // LIVE class "FY BCom"
  yearNo         Int? // LIVE year 1-4
  sequenceNo     Int      @default(0)
  isActive       Boolean  @default(true)
  isOtherCourse  Boolean  @default(false) // LIVE is_liberalart / other course form
  extraFee       Decimal? @db.Decimal(12, 2)
  extraStaffId   String?
  sections       Section[]
  enrollments    StudentEnrollment[]
  feeMasters     FeeMaster[]
  externalLinkClasses ExternalLinkClass[]
  optionalSubjects StudentOptionalSubject[]
}

model Section {
  id          String  @id @default(cuid())
  classId     String
  class       Class   @relation(fields: [classId], references: [id])
  name        String
  specializationId String?
  enrollments StudentEnrollment[]
  @@unique([classId, name])
}

model Subject {
  id       String  @id @default(cuid())
  campusId String
  name     String
  code     String?
  kind     String  @default("theory") // theory | practical | optional
  isOptional Boolean @default(false)
  categoryId String?
  category   SubjectCategory? @relation(fields: [categoryId], references: [id])
  subjectTypeId String?
  subjectType SubjectType? @relation(fields: [subjectTypeId], references: [id])
  offerings  ClassSubject[]
  optionalSelections StudentOptionalSubject[]
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  sectionId String?
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  staffId   String?
  sessionId String?
}

model Period {
  id        String @id @default(cuid())
  campusId  String
  name      String
  startTime String
  endTime   String
  sortOrder Int
}

model TimetableSlot {
  id        String @id @default(cuid())
  sessionId String
  classId   String
  sectionId String
  weekday   Int
  periodId  String
  subjectId String?
  staffId   String?
  room      String?
  @@unique([sessionId, sectionId, weekday, periodId])
}

model WorkingDay {
  id        String   @id @default(cuid())
  campusId  String
  sessionId String
  date      DateTime @db.Date
  isWorking Boolean
  note      String?
  @@unique([campusId, date])
}

// ─── People: students ──────────────────────────────────────

enum StudentStatus {
  ACTIVE
  DISABLED
  ALUMNI
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Category {
  id       String @id @default(cuid())
  campusId String
  name     String
  code     String? // LIVE Category ID
  students Student[]
}

model DisableReason {
  id       String @id @default(cuid())
  campusId String
  name     String
}

model Student {
  id             String         @id @default(cuid())
  campusId       String
  campus         Campus         @relation(fields: [campusId], references: [id])
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id])

  admissionNo    String // LIVE admission_no / Student ID
  rollNo         String?
  enrollmentNo   String? // LIVE student_prn
  abcId          String? // LIVE abc_id_number

  salutation     String?
  firstName      String // LIVE firstname
  middleName     String?
  lastName       String?
  nameAs12th     String? // LIVE name_as_12th
  nameAsAadhaar  String?

  gender         Gender?
  dob            DateTime? @db.Date
  birthPlace     String?

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  religion       String?
  caste          String?
  subCaste       String?
  minority       String?
  nationality    String?
  domicileState  String?
  admissionQuota String?

  mobile         String?
  email          String?
  phone          String?
  instituteEmail String?

  aadhaarEnc     String? // encrypt at app layer
  panEnc         String?

  admissionDate  DateTime? @db.Date
  feeCategory    String?
  photoUrl       String?
  signatureUrl   String?
  bloodGroup     String?
  house          String?
  pinCode        String?
  alternatePhone String?
  feeDefaulter   Boolean @default(false)
  rfidNumber     String?
  rfidMapped     Boolean @default(false)
  childIdActive  Boolean @default(true)
  parentIdActive Boolean @default(true)
  motherName     String?
  primaryParentName String?
  originalClass  String?
  lastSeen       String?
  details        Json?

  status         StudentStatus @default(ACTIVE)
  disableReasonId String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses      StudentAddress[]
  previousEdu    StudentEducation?
  bank           StudentBank?
  guardians      StudentGuardian[]
  documents      StudentDocument[]
  enrollments    StudentEnrollment[]
  invoices       FeeInvoice[]
  attendances    StudentAttendance[]
  marks          ExamMark[]
  optionalSubjects StudentOptionalSubject[]

  @@unique([campusId, admissionNo])
  @@index([campusId, enrollmentNo])
  @@index([campusId, lastName, firstName])
}

model StudentEnrollment {
  id               String @id @default(cuid())
  studentId        String
  student          Student @relation(fields: [studentId], references: [id])
  sessionId        String
  session          AcademicSession @relation(fields: [sessionId], references: [id])
  classId          String
  class            Class @relation(fields: [classId], references: [id])
  sectionId        String
  section          Section @relation(fields: [sectionId], references: [id])
  specializationId String?
  rollNo           String?
  isCurrent        Boolean @default(true)
  @@index([sessionId, classId, sectionId])
  @@index([studentId, sessionId])
}

model StudentAddress {
  id         String  @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id])
  kind       String // permanent | local
  line1      String?
  line2      String?
  line3      String?
  city       String?
  atPost     String?
  village    String?
  taluka     String?
  district   String?
  region     String?
  state      String?
  pincode    String?
  nation     String?
}

model StudentEducation {
  id            String  @id @default(cuid())
  studentId     String  @unique
  student       Student @relation(fields: [studentId], references: [id])
  qualification String?
  board         String?
  university    String?
  universityState String?
  universityPrn String?
  marksObtained Decimal? @db.Decimal(8, 2)
  marksTotal    Decimal? @db.Decimal(8, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  lastClassName String?
  academicYear  String?
  lastRollNo    String?
  examSeatNo    String?
  lastResult    String?
}

model StudentBank {
  id            String  @id @default(cuid())
  studentId     String  @unique
  student       Student @relation(fields: [studentId], references: [id])
  accountNoEnc  String?
  holderName    String?
  bankName      String?
  ifsc          String?
  branchName    String?
  branchAddress String?
  accountType   String?
}

model Guardian {
  id          String  @id @default(cuid())
  userId      String? @unique
  user        User?   @relation(fields: [userId], references: [id])
  name        String
  phone       String?
  email       String?
  occupation  String?
  income      Decimal? @db.Decimal(12, 2)
  panEnc      String?
  photoUrl    String?
  links       StudentGuardian[]
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   String // father | mother | spouse | other
  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  @@id([studentId, guardianId, relation])
}

model StudentDocument {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  title     String
  type      String?
  fileUrl   String
  createdAt DateTime @default(now())
}

model CustomField {
  id         String  @id @default(cuid())
  campusId   String
  belongTo   String // LIVE Student Staff Liberal Art Admission Documents
  type       String // LIVE Input Number ...
  name       String
  values     String? // comma separated
  columnSpan Int     @default(6)
  required   Boolean @default(false)
  visible    Boolean @default(true)
  onTable    Boolean @default(false)
  validation String?
}

model CustomFieldValue {
  id        String @id @default(cuid())
  fieldId   String
  entityId  String
  value     String?
  @@index([fieldId, entityId])
}

// ─── Fees ──────────────────────────────────────────────────

model FeeType {
  id       String @id @default(cuid())
  campusId String
  name     String
  code     String?
  isActive Boolean @default(true)
  description String?
  isRecurring Boolean @default(false)
  lines    FeeMasterLine[]
}

model FeeGroup {
  id       String @id @default(cuid())
  campusId String
  name     String
  masters  FeeMaster[]
}

model FeeMaster {
  id        String @id @default(cuid())
  campusId  String
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  groupId   String
  group     FeeGroup @relation(fields: [groupId], references: [id])
  dueDate   DateTime? @db.Date
  isActive  Boolean @default(true)
  name      String  @default("")
  description String?
  classId   String?
  class     Class?  @relation(fields: [classId], references: [id])
  lines     FeeMasterLine[]
  invoices  FeeInvoice[]
}

model FeeMasterLine {
  id         String    @id @default(cuid())
  masterId   String
  master     FeeMaster @relation(fields: [masterId], references: [id])
  feeTypeId  String
  feeType    FeeType   @relation(fields: [feeTypeId], references: [id])
  amount     Decimal   @db.Decimal(12, 2)
  installmentName String @default("Single Installment")
  displayOrder Int @default(0)
}

model FeeDiscount {
  id         String   @id @default(cuid())
  campusId   String
  name       String
  code       String?
  kind       String // percent | fixed  LIVE account_type
  percentage Decimal? @db.Decimal(5, 2)
  amount     Decimal? @db.Decimal(12, 2)
  description String?
}

model FineRule {
  id        String @id @default(cuid())
  campusId  String
  name      String
  afterDays Int
  kind      String // percent | fixed
  value     Decimal @db.Decimal(12, 2)
}

enum InvoiceStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
  CARRIED_FORWARD
}

model FeeInvoice {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])
  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  masterId    String?
  master      FeeMaster?    @relation(fields: [masterId], references: [id])
  status      InvoiceStatus @default(DUE)
  total       Decimal       @db.Decimal(12, 2)
  paid        Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  fine        Decimal       @default(0) @db.Decimal(12, 2)
  reference   String?
  lines       FeeInvoiceLine[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  @@index([studentId, sessionId])
}

model FeeInvoiceLine {
  id         String     @id @default(cuid())
  invoiceId  String
  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id])
  feeTypeId  String
  description String
  amount     Decimal    @db.Decimal(12, 2)
  paid       Decimal    @default(0) @db.Decimal(12, 2)
  installmentName String @default("Single Installment")
  dueDate    DateTime?  @db.Date
  reference  String?
  metadata   Json?
}

enum PaymentMethod {
  CASH
  CHEQUE
  DD
  BANK_TRANSFER
  UPI
  CARD
  GATEWAY
  SCHOLARSHIP
  WAIVER
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     FeeInvoice    @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  fine        Decimal       @default(0) @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  receiptNo   String        @unique
  note        String?
  cashDepositNumber String?
  reversalReason String?
  paidAt      DateTime
  collectedBy String?
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
}

// ─── Attendance ────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALFDAY
  HOLIDAY
  LEAVE
}

model StudentAttendance {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  date      DateTime          @db.Date
  subjectId String?
  status    AttendanceStatus
  markedBy  String?
  note      String @default("")
  @@unique([studentId, date, subjectId])
  @@index([date])
}

model StaffAttendance {
  id       String            @id @default(cuid())
  staffId  String
  staff    Staff             @relation(fields: [staffId], references: [id])
  date     DateTime          @db.Date
  status   AttendanceStatus
  inTime   String?
  outTime  String?
  @@unique([staffId, date])
}

model LeaveType {
  id        String @id @default(cuid())
  campusId  String
  name      String
  daysYear  Int    @default(0)
  requests  LeaveRequest[]
}

model LeaveRequest {
  id         String @id @default(cuid())
  staffId    String?
  studentId  String?
  leaveTypeId String
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  reason     String?
  status     String  @default("pending") // pending approved rejected
  approverId String?
}

// ─── Exams ─────────────────────────────────────────────────

enum ExamKind {
  GENERAL_PASS_FAIL
  SCHOOL_GRADE
  COLLEGE_GRADE
  GPA
  AVERAGE_PASSING
}

model ExamGroup {
  id             String   @id @default(cuid())
  campusId       String
  sessionId      String
  session        AcademicSession @relation(fields: [sessionId], references: [id])
  name           String
  examType       ExamKind
  groupKind      String   @default("Regular") // LIVE Regular | ATKT
  description    String?
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  examMonthYear  String?
  isAdditional   Boolean  @default(false)
  isActive       Boolean  @default(true)
  revaluationOn  Boolean  @default(false)
  exams          Exam[]
}

model Exam {
  id          String    @id @default(cuid())
  examGroupId String
  group       ExamGroup @relation(fields: [examGroupId], references: [id])
  name        String
  subjects    ExamSubject[]
}

model ExamSubject {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  subjectId String
  dateFrom  DateTime? @db.Date
  startTime String?
  durationMin Int?
  roomNo    String?
  maxMarks  Decimal  @db.Decimal(8, 2)
  minMarks  Decimal  @db.Decimal(8, 2)
  marks     ExamMark[]
}

model Grade {
  id        String @id @default(cuid())
  campusId  String
  name      String
  letter    String
  minPct    Decimal @db.Decimal(5, 2)
  maxPct    Decimal @db.Decimal(5, 2)
  points    Decimal? @db.Decimal(4, 2)
}

model ExamMark {
  id            String      @id @default(cuid())
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  marks         Decimal?    @db.Decimal(8, 2)
  isAbsent      Boolean     @default(false)
  gradeId       String?
  isBlocked     Boolean     @default(false)
  finalizedAt   DateTime?
  @@unique([examSubjectId, studentId])
}

// ─── Staff ─────────────────────────────────────────────────

model Designation {
  id       String @id @default(cuid())
  campusId String
  name     String
  staff    Staff[]
}

model Staff {
  id             String   @id @default(cuid())
  campusId       String
  campus         Campus   @relation(fields: [campusId], references: [id])
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  employeeId     String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  gender         Gender?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id])
  joiningDate    DateTime? @db.Date
  isActive       Boolean  @default(true)
  photoUrl       String?
  attendances    StaffAttendance[]
  @@unique([campusId, employeeId])
}

// ─── Comms ─────────────────────────────────────────────────

model Notice {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  title       String
  body        String
  audience    String // all | staff | students | class
  classId     String?
  noticeType  String   @default("News")
  allowReply  Boolean  @default(false)
  authorName  String   @default("")
  authorUserId String?
  board       String   @default("school")
  audienceKey String   @default("all")
  academicYear String  @default("")
  publishAt   DateTime @default(now())
  isPublished Boolean  @default(true)
  attachments NoticeAttachment[]
  views       NoticeView[]
}

model Homework {
  id          String   @id @default(cuid())
  campusId    String
  classId     String
  sectionId   String
  subjectId   String?
  title       String
  description String?
  assignedOn  DateTime @db.Date
  dueOn       DateTime @db.Date
  fileUrl     String?
  createdBy   String?
}

model ScreenRecord {
  id        String   @id @default(cuid())
  campusId  String
  screenKey String
  title     String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campusId, screenKey])
}

// ─── School World additions ────────────────────────────────

model AdmissionEnquiry {
  id            String   @id @default(cuid())
  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id])
  formNumber    String
  academicYear  String
  enquiryDate   DateTime? @db.Date
  enquiryStatus String   @default("Cold Enquiry")
  studentName   String
  primaryContact String
  email         String?
  classApplied  String?
  data          Json     @default("{}")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([campusId, formNumber])
  @@index([campusId, enquiryDate])
}

model SchoolRoute {
  id            String  @id @default(cuid())
  campusId      String
  campus        Campus  @relation(fields: [campusId], references: [id])
  name          String
  stops         String  @default("")
  vehicleNumber String  @default("")
  driverName    String  @default("")
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([campusId, name])
}

model NoticeAttachment {
  id          String @id @default(cuid())
  noticeId    String
  notice      Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String @default("application/octet-stream")
  fileSize    Int    @default(0)
  fileData    Bytes
  createdAt   DateTime @default(now())
}

model NoticeView {
  id        String   @id @default(cuid())
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  viewerUserId String
  viewedAt  DateTime @default(now())
  @@unique([noticeId, viewerUserId])
}

model Event {
  id        String   @id @default(cuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  title     String
  detail    String   @default("")
  eventDate DateTime? @db.Date
  createdBy String?
  createdAt DateTime @default(now())
  recipients EventRecipient[]
}

model EventRecipient {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String?
  label   String @default("")
}

model Message {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  batchId     String
  senderId    String?
  subject     String   @default("")
  body        String
  status      String   @default("sent")
  scheduledAt DateTime?
  sentAt      DateTime @default(now())
  recipients  MessageRecipient[]
  attachments MessageAttachment[]
  @@index([campusId, batchId])
}

model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?
  readAt    DateTime?
}

model MessageAttachment {
  id          String  @id @default(cuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String  @default("application/octet-stream")
  fileSize    Int     @default(0)
  fileData    Bytes
  createdAt   DateTime @default(now())
}

model Questionnaire {
  id        String   @id @default(cuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  title     String   @default("")
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  questions QuestionnaireQuestion[]
  responses QuestionnaireResponse[]
}

model QuestionnaireQuestion {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  prompt          String
  answerType      String        @default("Text answer")
  options         Json          @default("[]")
  sortOrder       Int           @default(0)
}

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  respondentUserId String
  answer          Json
  submittedAt     DateTime      @default(now())
  @@unique([questionnaireId, respondentUserId])
}

model StoreItem {
  id           String   @id @default(cuid())
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id])
  itemCode     String
  name         String
  currentStock Int      @default(0)
  minimumStock Int      @default(0)
  metadata     Json     @default("{}")
  updatedAt    DateTime @updatedAt
  @@unique([campusId, itemCode])
}

model StoreVendor {
  id            String   @id @default(cuid())
  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id])
  name          String
  contactPerson String   @default("")
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  createdAt     DateTime @default(now())
}

model StaffCategory {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  assignments StaffCategoryAssignment[]
  @@unique([campusId, name])
}

model StaffCategoryAssignment {
  id         String @id @default(cuid())
  categoryId String
  category   StaffCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  staffId    String
  @@unique([categoryId, staffId])
}

model CommunicationCategoryRestriction {
  id         String @id @default(cuid())
  campusId   String
  categoryId String
  channel    String
  @@unique([campusId, categoryId, channel])
}

model ExternalLink {
  id        String   @id @default(cuid())
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  title     String
  url       String
  createdAt DateTime @default(now())
  classes   ExternalLinkClass[]
}

model ExternalLinkClass {
  linkId  String
  classId String
  link    ExternalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([linkId, classId])
}

model SubjectCategory {
  id        String    @id @default(cuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id])
  name      String
  subjects  Subject[]
  @@unique([campusId, name])
}

model SubjectType {
  id        String    @id @default(cuid())
  campusId  String
  campus    Campus    @relation(fields: [campusId], references: [id])
  name      String
  subjects  Subject[]
  @@unique([campusId, name])
}

model SubjectTypeAssignment {
  subjectId     String
  subjectTypeId String
  @@id([subjectId, subjectTypeId])
}

model SubjectApplicableClass {
  subjectId String
  classId   String
  @@id([subjectId, classId])
}

model StudentOptionalSubject {
  id        String          @id @default(cuid())
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  classId   String
  class     Class           @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject         @relation(fields: [subjectId], references: [id])
  @@unique([studentId, sessionId, classId, subjectId])
}

model AdminTemplateCatalog {
  id            String   @id @default(cuid())
  templateType  String
  templateCode  String
  templateName  String
  version       Int      @default(1)
  description   String   @default("")
  isActive      Boolean  @default(true)
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  receiptSettings FeeReceiptTemplateSettings?
  performanceSettings PerformanceTemplateSettings?
  assignments   SchoolTemplateAssignment[]
  @@unique([templateType, templateCode, version])
}

model FeeReceiptTemplateSettings {
  templateId          String @id
  template            AdminTemplateCatalog @relation(fields: [templateId], references: [id], onDelete: Cascade)
  showSchoolLogo      Boolean @default(true)
  showSchoolName      Boolean @default(true)
  showSchoolAddress   Boolean @default(true)
  showSchoolPhone     Boolean @default(true)
  showSchoolEmail     Boolean @default(false)
  showStudentName     Boolean @default(true)
  showStudentCode     Boolean @default(true)
  showClassSection    Boolean @default(true)
  showAcademicYear    Boolean @default(true)
  showParentName      Boolean @default(true)
  showFeeBreakdown    Boolean @default(true)
  showPaymentMethod   Boolean @default(true)
  showReceiptNumber   Boolean @default(true)
  showPaymentReference Boolean @default(true)
  showPaidAmount      Boolean @default(true)
  showBalance         Boolean @default(false)
  showSignatureLine   Boolean @default(true)
  pageOrientation     String  @default("portrait")
  headerText          String  @default("FEE RECEIPT")
  footerText          String  @default("Thank you for your payment.")
  updatedAt           DateTime @updatedAt
  notes               FeeReceiptTemplateNote[]
}

model FeeReceiptTemplateNote {
  id         String @id @default(cuid())
  templateId String
  settings   FeeReceiptTemplateSettings @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
  noteText   String
  sortOrder  Int @default(0)
}

model PerformanceTemplateSettings {
  templateId       String @id
  template         AdminTemplateCatalog @relation(fields: [templateId], references: [id], onDelete: Cascade)
  academicYear     String @default("")
  reportTitle      String @default("Student Performance Report")
  showStudentPhoto Boolean @default(false)
  showMarks        Boolean @default(true)
  showGrade        Boolean @default(true)
  showRemarks      Boolean @default(true)
  footerText       String @default("")
  updatedAt        DateTime @updatedAt
  terms            PerformanceTemplateTerm[]
  subterms         PerformanceTemplateSubterm[]
}

model PerformanceTemplateTerm {
  id         String @id @default(cuid())
  templateId String
  settings   PerformanceTemplateSettings @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
  termName   String
  sortOrder  Int @default(0)
  @@unique([templateId, termName])
}

model PerformanceTemplateSubterm {
  id          String @id @default(cuid())
  templateId  String
  settings    PerformanceTemplateSettings @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
  subtermName String
  sortOrder   Int @default(0)
  @@unique([templateId, subtermName])
}

model SchoolTemplateAssignment {
  id              String @id @default(cuid())
  userId          String
  templateType    String
  templateId      String
  template        AdminTemplateCatalog @relation(fields: [templateId], references: [id])
  appliedByUserId String
  appliedAt       DateTime @default(now())
  @@unique([userId, templateType])
}
