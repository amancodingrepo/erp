DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp
# Generate locally (32+ bytes). Never commit the real value.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Railway: set these on the web service (see README Railway section).
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# AUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# NEXTAUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
SEED_ADMIN_PASSWORD=Admin@12345
# AES-256-GCM for Aadhaar/PAN. Required (>=32 chars) when NODE_ENV=production.
FIELD_ENCRYPTION_KEY=
# Optional gateway fallback when no PaymentMerchant rows exist.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional delivery hooks for SMS/email (otherwise messages are logged only).
SMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
