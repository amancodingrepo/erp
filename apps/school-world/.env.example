# Copy to .env before running. Keep this file out of version control.
NODE_ENV=production
PORT=3001
POSTGRES_DB=school_diary
POSTGRES_USER=schooldiary
POSTGRES_PASSWORD=schooldiary_dev
DATABASE_URL=postgresql://schooldiary:schooldiary_dev@db:5432/school_diary
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3001
SEED_DEMO_DATA=true
DEFAULT_SCHOOL_NAME=Sanford School
DEFAULT_SCHOOL_CODE=SANFORD
DEFAULT_ADMIN_EMAIL=admin@sanford.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPERADMIN_EMAIL=superadmin@schooldiary.local
DEFAULT_SUPERADMIN_PASSWORD=SuperAdmin123!
PGPOOL_MAX=10
MAX_JSON_SIZE=12mb
